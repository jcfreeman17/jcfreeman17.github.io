---

<Base title="Research">
  <main class="max-w-5xl mx-auto px-6 pt-24 pb-12 md:pt-28 md:pb-20">
    <SectionHeader
      title="Research"
      subtitle="The long-term evolution of human populations, resources, and institutions."
    />

    <section class="grid md:grid-cols-3 gap-8 mb-16">
      <article class="bg-brand-parchment rounded-sm shadow-[0_2px_12px_rgba(107,76,59,0.10)] p-8 border border-brand-stone/20">
        <h2 class="text-xl font-medium text-brand-charcoal mb-4">Population Dynamics</h2>
        <p class="text-brand-charcoal leading-relaxed">
          Investigating long-term population growth, decline, migration, and demographic transitions to explain
          how human communities expanded and reorganized through time.
        </p>
      </article>
      <article class="bg-brand-parchment rounded-sm shadow-[0_2px_12px_rgba(107,76,59,0.10)] p-8 border border-brand-stone/20">
        <h2 class="text-xl font-medium text-brand-charcoal mb-4">Data Synthesis</h2>
        <p class="text-brand-charcoal leading-relaxed">
          Building and integrating large "ethnographic", archaeological, and radiocarbon datasets to support
          comparative analyses and new models of long-term social and environmental change.
        </p>
      </article>
      <article class="bg-brand-parchment rounded-sm shadow-[0_2px_12px_rgba(107,76,59,0.10)] p-8 border border-brand-stone/20">
        <h2 class="text-xl font-medium text-brand-charcoal mb-4">Cognitive Styles & Collective Action</h2>
        <p class="text-brand-charcoal leading-relaxed">
          Examining how cognition, decision-making, and cooperation shape institutional dynamics and collective
          outcomes in human societies.
        </p>
      </article>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold text-brand-charcoal mb-6">Publications</h2>

      <div class="flex flex-wrap gap-3 mb-8" role="tablist" aria-label="Research projects">
        {projects.map((project) => (
          <button
            type="button"
            class:list={['project-tab', project.id === defaultProject && 'project-tab-active']}
            data-project-tab={project.id}
            aria-selected={project.id === defaultProject}
          >
            {project.label}
          </button>
        ))}
      </div>

      <div>
        {publications.map((publication) => (
          <div data-project={publication.project} hidden={publication.project !== defaultProject}>
            <PublicationItem
              authors={publication.authors}
              year={publication.year}
              title={publication.title}
              journal={publication.journal}
              doi={publication.doi}
            />
          </div>
        ))}
      </div>
    </section>

  </main>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll('[data-project-tab]'));
  const publicationItems = Array.from(document.querySelectorAll('[data-project]'));

  const setActiveProject = (projectId) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.projectTab === projectId;
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.classList.toggle('project-tab-active', active);
    });

    publicationItems.forEach((item) => {
      item.hidden = item.dataset.project !== projectId;
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.dataset.projectTab) setActiveProject(tab.dataset.projectTab);
    });
  });
</script>

<style>
  .project-tab {
    border: 1px solid rgba(107, 76, 59, 0.3);
    color: #2f2f2f;
    padding: 0.45rem 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .project-tab:hover {
    border-color: #c96f4f;
    color: #c96f4f;
  }

  .project-tab-active {
    background-color: #c96f4f;
    border-color: #c96f4f;
    color: #fff;
  }
</style>
