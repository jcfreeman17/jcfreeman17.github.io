---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { withBase } from '../utils/paths';
---

<Base title="Collaboration">
  <main class="max-w-5xl mx-auto px-6 pt-24 pb-12 md:pt-28 md:pb-20">
    <SectionHeader
      title="Collaboration"
      subtitle="Cross-disciplinary collaboration to explain long-term social and environmental change."
    />

    <p class="text-brand-charcoal leading-relaxed mb-12 max-w-3xl">
      My work is collaborative by design and integrates archaeology, paleoecology, anthropology, and mathematical
      modeling. These partnerships support comparative datasets, theory development, and applications to current
      sustainability challenges.
    </p>

    <section class="bg-brand-parchment rounded-sm shadow-[0_2px_12px_rgba(107,76,59,0.10)] p-8 border border-brand-stone/20 mb-16">
      <h2 class="text-xl font-medium text-brand-charcoal mb-4">PEOPLE 3000</h2>
      <p class="text-brand-charcoal leading-relaxed mb-4">
        PEOPLE 3000 is a global working group that connects archaeologists, paleoecologists, and mathematicians
        to study the long-term population ecology of human societies. The network helps build and evaluate
        large-scale datasets that support new explanations of demographic growth, decline, and resilience.
      </p>
      <a
        href="https://pastglobalchanges.org/ini/wg/people-3000/intro"
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-terracotta hover:text-brand-earth font-medium text-sm tracking-wide transition-colors"
      >
        Visit PEOPLE 3000 working group →
      </a>
    </section>

    <section class="mb-16">
      <h2 class="text-xl font-medium text-brand-charcoal mb-4">Collaborator Network</h2>
      <p class="text-brand-charcoal leading-relaxed mb-4">
        Ongoing collaborations include colleagues across anthropology, archaeology, and sustainability science:
      </p>
      <ul class="grid sm:grid-cols-2 gap-3 text-brand-charcoal">
        <li>Jacopo A. Baggio</li>
        <li>Erick Robinson</li>
        <li>Raymond P. Mauldin</li>
        <li>Robert J. Hard</li>
        <li>Eva A. Peralta</li>
        <li>Adolfo F. Gil</li>
        <li>John M. Anderies</li>
        <li>Daniel Bird</li>
      </ul>
    </section>

    <section class="text-center py-8 border-t border-brand-stone/30">
      <p class="text-brand-charcoal mb-6">Interested in collaborating?</p>
      <a
        href={withBase('contact')}
        class="inline-block bg-brand-terracotta text-white text-sm font-medium tracking-widest uppercase px-8 py-3 hover:bg-brand-earth transition-colors"
      >
        Get in Touch →
      </a>
    </section>
  </main>
</Base>
