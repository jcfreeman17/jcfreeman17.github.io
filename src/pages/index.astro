---
import Base from '../layouts/Base.astro';
import { withBase } from '../utils/paths';

const heroImage = withBase('images/hero-placeholder.jpg');
---

<Base isHome={true}>
  <section class="relative min-h-screen flex items-center justify-center">
    <div
      class="absolute inset-0 bg-cover bg-center bg-brand-earth"
      style={`background-image: url('${heroImage}');`}
    />

    <div class="absolute inset-0 bg-[rgba(28,20,14,0.58)]" />

    <div class="relative z-10 text-center text-white max-w-2xl px-6 pt-16">
      <p class="text-sm tracking-widest uppercase text-brand-terracotta mb-4">
        Utah State University · Anthropology
      </p>
      <h1 class="text-2xl md:text-4xl font-light leading-snug mb-8">
        [MISSION PLACEHOLDER]
      </h1>
      <a
        href={withBase('research')}
        class="inline-block bg-brand-terracotta text-white text-sm font-medium tracking-widest uppercase px-8 py-3 hover:bg-brand-earth transition-colors"
      >
        Explore Research →
      </a>
    </div>
  </section>
</Base>
