---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="border-b border-brand-terracotta/40 pb-4 mb-12">
  <h1 class="text-3xl md:text-5xl font-semibold text-brand-charcoal">{title}</h1>
  {subtitle && (
    <p class="mt-3 text-brand-stone leading-relaxed max-w-3xl">{subtitle}</p>
  )}
</header>
